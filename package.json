{
  "name": "duckgammon",
  "version": "0.1.0",
  "description": "Lichess-inspired backgammon app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx src/server/index.ts",
    "start": "node --import tsx src/server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "npx playwright test",
    "test:visual:update": "npx playwright test --update-snapshots",
    "screenshots": "npm run build && npx playwright test --reporter=list"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "AGPL-3.0",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/ws": "^8.18.1",
    "playwright": "^1.56.1",
    "solid-js": "^1.9.12",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-solid": "^2.11.11",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "ws": "^8.20.0"
  }
}
