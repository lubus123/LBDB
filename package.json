{
  "name": "duckgammon",
  "version": "0.1.0",
  "description": "Lichess-inspired backgammon app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx --env-file=.env src/server/index.ts",
    "dev:full": "npm run build && (ps aux | grep 'server/index' | grep -v grep | awk '{print $2}' | xargs -r kill 2>/dev/null); sleep 0.5 && tsx --env-file=.env src/server/index.ts",
    "start": "node --import tsx src/server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:server": "vitest run --config vitest.config.ts src/server/test",
    "test:server:watch": "vitest --config vitest.config.ts src/server/test",
    "test:unit": "vitest run --config vitest.config.ts src/engine/test src/server/test/unit",
    "test:integration": "vitest run --config vitest.config.ts src/server/test/integration",
    "test:visual": "npx playwright test",
    "test:visual:update": "npx playwright test --update-snapshots",
    "screenshots": "npm run build && npx playwright test --reporter=list"
  },
  "engines": {
    "node": ">=23"
  },
  "license": "AGPL-3.0",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.0.1",
    "playwright": "^1.56.1",
    "solid-js": "^1.9.12",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-solid": "^2.11.11",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "ws": "^8.20.0"
  }
}
