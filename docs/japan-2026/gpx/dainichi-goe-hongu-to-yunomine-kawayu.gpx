    <rtept lat="33.8316286" lon="135.7619782"><name>Dainichi-goe ridge</name></rtept>
    <rtept lat="33.8291897" lon="135.7577217"><name>Tsuboyu</name></rtept>
    <rtept lat="33.8129008" lon="135.7702325"><name>Sansuikan Kawayu Midoriya</name></rtept>
